PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# CockroachDB connection (TLS is enabled by default).
DB_HOST=
DB_PORT=26257
DB_USER=
DB_PASSWORD=
DB_NAME=defaultdb
DB_SSL=true
# Optional CA certificate path for a custom CockroachDB certificate.
DB_SSL_CA_PATH=
# Alternatively, set DATABASE_URL and leave the DB_* connection fields empty.
DATABASE_URL=

# Use a unique random value of at least 32 characters.
JWT_SECRET=
COOKIE_SECURE=false

# Leave SMTP values blank in local development to print verification links
# in the server terminal. Configure these to send verification emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
